

main:



    hlt


aes:
    and T0,a0,a0 
    set T6, 9
    set 







mul:
    xor T0,T0,T0
    xor T1,T1,T1
    and T0,a0,a0
    and T1,a1,a1
    set T2, 0
    set R11, 1
    set R15, end
    set R16, loop
    loop:
        je T1,T2,R15
        add T2,T2,T0 
        sub T1,T1,R11
        je T1,T1,R16
    end:
    ret







